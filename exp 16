#include <stdio.h>

struct emp {
    int id;
    char name[20];
};

int main() {
    FILE *fp=fopen("emp.dat","wb+");
    struct emp e;

    e.id=1;
    scanf("%s",e.name);

    fwrite(&e,sizeof(e),1,fp);

    rewind(fp);

    fread(&e,sizeof(e),1,fp);

    printf("%d %s",e.id,e.name);

    fclose(fp);
    return 0;
}
