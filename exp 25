#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat s;
    DIR *d;

    fd = open("file.txt", O_RDONLY);
    printf("File opened\n");

    lseek(fd,0,SEEK_SET);
    printf("File pointer moved\n");

    stat("file.txt",&s);
    printf("File size = %ld bytes\n",s.st_size);

    close(fd);

    d = opendir(".");
    printf("Directory opened\n");

    closedir(d);

    return 0;
}
