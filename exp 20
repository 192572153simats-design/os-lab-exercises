#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t wrt;
int data=10;

void *reader(void *x) {
    printf("Read %d\n",data);
    return NULL;
}

void *writer(void *x) {
    sem_wait(&wrt);
    data++;
    printf("Written\n");
    sem_post(&wrt);
    return NULL;
}

int main() {
    pthread_t r,w;
    sem_init(&wrt,0,1);

    pthread_create(&r,NULL,reader,NULL);
    pthread_create(&w,NULL,writer,NULL);

    pthread_join(r,NULL);
    pthread_join(w,NULL);

    return 0;
}
