#include <stdio.h>

int main()
{
    int page[5]={1,2,3,1,4};
    int frame[3]={-1,-1,-1};
    int recent[3]={0,0,0};
    int i,j,pos,found,fault=0;

    for(i=0;i<5;i++)
    {
        found=0;

        for(j=0;j<3;j++)
        {
            if(frame[j]==page[i])
            {
                found=1;
                recent[j]=i;
            }
        }

        if(found==0)
        {
            pos=0;

            for(j=1;j<3;j++)
                if(recent[j]<recent[pos])
                    pos=j;

            frame[pos]=page[i];
            recent[pos]=i;
            fault++;
        }
    }

    printf("Page Faults = %d\n",fault);

    return 0;
}
