#include <stdio.h>

int main() {
    int alloc[3]={1,1,2};
    int max[3]={3,2,2};
    int avail[3]={2,1,0};

    int need[3];

    for(int i=0;i<3;i++)
        need[i]=max[i]-alloc[i];

    for(int i=0;i<3;i++)
        if(need[i]<=avail[i])
            printf("Safe\n");
        else
            printf("Unsafe\n");

    return 0;
}
