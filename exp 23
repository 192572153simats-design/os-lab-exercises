#include <stdio.h>

int main()
{
    int b[5], p[5];
    int i, j;

    printf("Enter 5 block sizes:\n");
    for(i=0; i<5; i++)
        scanf("%d", &b[i]);

    printf("Enter 5 process sizes:\n");
    for(i=0; i<5; i++)
        scanf("%d", &p[i]);

    for(i=0; i<5; i++)
    {
        for(j=0; j<5; j++)
        {
            if(b[j] >= p[i])
            {
                printf("Process %d -> Block %d\n", i+1, j+1);
                b[j] = b[j] - p[i];
                break;
            }
        }

        if(j == 5)
            printf("Process %d -> Not Allocated\n", i+1);
    }

    return 0;
}
