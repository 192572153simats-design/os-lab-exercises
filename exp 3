#include <stdio.h>

int main()
{
    int n, i, bt[10], wt[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &bt[i]);

    wt[0] = 0;

    for(i = 1; i < n; i++)
        wt[i] = wt[i-1] + bt[i-1];

    printf("\nWaiting Time:\n");
    for(i = 0; i < n; i++)
        printf("P%d = %d\n", i + 1, wt[i]);

    return 0;
}
