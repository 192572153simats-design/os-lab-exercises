#include <stdio.h>

int main()
{
    int page[5], frame[3], i, j, k=0;
    int fault=0, found;

    printf("Enter 5 pages:\n");

    for(i=0;i<5;i++)
        scanf("%d",&page[i]);

    for(i=0;i<3;i++)
        frame[i]=-1;

    for(i=0;i<5;i++)
    {
        found=0;

        for(j=0;j<3;j++)
            if(frame[j]==page[i])
                found=1;

        if(found==0)
        {
            frame[k]=page[i];
            k=(k+1)%3;
            fault++;
        }
    }

    printf("Page Faults = %d\n",fault);

    return 0;
}
