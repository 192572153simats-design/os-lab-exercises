#include <stdio.h>

int main()
{
    int b[5], p[5], i, j, w;

    printf("Enter 5 block sizes:\n");
    for(i=0;i<5;i++)
        scanf("%d",&b[i]);

    printf("Enter 5 process sizes:\n");
    for(i=0;i<5;i++)
        scanf("%d",&p[i]);

    for(i=0;i<5;i++)
    {
        w = -1;

        for(j=0;j<5;j++)
        {
            if(b[j] >= p[i])
            {
                if(w == -1 || b[j] > b[w])
                    w = j;
            }
        }

        if(w != -1)
        {
            printf("Process %d -> Block %d\n",i+1,w+1);
            b[w] = b[w] - p[i];
        }
        else
            printf("Process %d -> Not Allocated\n",i+1);
    }

    return 0;
}
