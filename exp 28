#include <stdio.h>
#include <string.h>

int main()
{
    char word[20];
    char line[3][100] = {
        "Operating System",
        "Linux is easy",
        "CPU Scheduling"
    };

    int i;

    printf("Enter word: ");
    scanf("%s", word);

    for(i = 0; i < 3; i++)
    {
        if(strstr(line[i], word) != NULL)
        {
            printf("%s\n", line[i]);
        }
    }

    return 0;
}
